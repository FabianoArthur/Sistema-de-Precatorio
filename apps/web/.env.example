VITE_API_URL=http://localhost:3001

# Demo estática sem backend (usada no GitHub Pages). Deixe desligado em dev normal.
# VITE_DEMO_MODE=true
# Caminho base do build (o Pages serve em /<repo>/). Lido pelo vite.config.ts.
# VITE_BASE=/Sistema-de-Precatorio/

# Sentry (opcional — sem DSN o SDK não inicializa)
VITE_SENTRY_DSN=
VITE_SENTRY_RELEASE=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
VITE_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0
VITE_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=0
