# Server
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173

# Database
DATABASE_URL=postgresql://preca:preca_dev@localhost:5432/preca_dev?schema=public

# JWT
JWT_SECRET=change-me-in-production-please-very-long-string
JWT_EXPIRES_IN=7d

# Seed (usuários iniciais)
SEED_USER_1_EMAIL=admin@preca.local
SEED_USER_1_SENHA=admin123
SEED_USER_1_NOME=Administrador
SEED_USER_2_EMAIL=analista@preca.local
SEED_USER_2_SENHA=analista123
SEED_USER_2_NOME=Analista

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=preca-anexos
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_PUBLIC_URL=

# Notificações
SLA_PARADO_DIAS=7
